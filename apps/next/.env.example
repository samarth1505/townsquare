# Where the Next.js SERVER reads data from (server to server, so no CORS involved).
API_URL=http://localhost:4000
# The public address of THIS site: used for canonical links, the sitemap and social-preview images.
SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate (the backend sends it in the x-revalidate-secret header).
# Set a long random value in a git-ignored .env. If empty, revalidation is switched off.
REVALIDATE_SECRET=
